DATABASE_URL=sqlserver://localhost:14330;database=aura;user=sa;password=YOUR_PASSWORD_HERE;encrypt=true;trustServerCertificate=true

# Cloudinary - storage principal de fotos/video para productos nuevos
# (reemplaza a Google Drive, ver services/cloudinary.service.js). Obligatorias:
# el servicio lanza error al arrancar si falta alguna.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth 2.0 (Desktop app client) - user-delegated Drive access.
# Legado: solo necesario para servir/limpiar medios de productos creados
# ANTES de la migración a Cloudinary (ver services/googleDrive.service.js).
# Ningún producto nuevo sube a Drive.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token

# Drive folder (in the clients own My Drive) where legacy product media is stored.
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Backend HTTP port.
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173

# URL pública del frontend (usada para armar og:url y el fallback og:image).
FRONTEND_URL=http://localhost:5173

# URL pública del propio backend (usada para armar og:image de fotos legacy
# de Google Drive, servidas vía el proxy /api/products/:id/fotos/:fotoId).
BACKEND_PUBLIC_URL=http://localhost:4000

# Secreto para firmar los JWT del login de admin. Generar uno random y
# distinto en cada ambiente, ej: openssl rand -base64 48
JWT_SECRET=

# Número de WhatsApp del negocio para el botón de contacto del catálogo
# público, en formato internacional sin "+" ni espacios (listo para
# armar un link wa.me/<numero>).
WHATSAPP_NUMERO=5491122334455

# Horario de atención (formato 24hs, solo la hora) usado para calcular si
# el botón de WhatsApp muestra "te respondemos ahora" o el mensaje de fuera
# de horario. Se evalúa siempre en horario de Argentina
# (America/Argentina/Buenos_Aires), sin importar en qué timezone corra el
# servidor. WHATSAPP_HORA_DESDE es inclusive, WHATSAPP_HORA_HASTA es exclusivo.
WHATSAPP_HORA_DESDE=9
WHATSAPP_HORA_HASTA=18

# Días de la semana en que el negocio atiende, separados por coma, usando
# la misma numeración que Date.getDay() (0=domingo..6=sábado).
# Ejemplo: lunes a viernes = 1,2,3,4,5
WHATSAPP_DIAS=1,2,3,4,5
