DATABASE_URL=sqlserver://localhost:14330;database=aura;user=sa;password=YOUR_PASSWORD_HERE;encrypt=true;trustServerCertificate=true

# Cloudinary - storage de fotos y video del catálogo
# (ver services/cloudinary.service.js). Obligatorias:
# el servicio lanza error al arrancar si falta alguna.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Backend HTTP port.
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173

# URL pública del frontend (usada para armar og:url y el fallback og:image).
FRONTEND_URL=http://localhost:5173

# URL pública del propio backend. Obligatoria al arrancar: sin ella
# `urlBackend()` cae a localhost en silencio.
BACKEND_PUBLIC_URL=http://localhost:4000

# Secreto para firmar los JWT del login de admin. Generar uno random y
# distinto en cada ambiente, ej: openssl rand -base64 48
JWT_SECRET=

# Número de WhatsApp del negocio para el botón de contacto del catálogo
# público, en formato internacional sin "+" ni espacios (listo para
# armar un link wa.me/<numero>).
WHATSAPP_NUMERO=5491122334455

# Horario de atención (formato 24hs, solo la hora) usado para calcular si
# el botón de WhatsApp muestra "te respondemos ahora" o el mensaje de fuera
# de horario. Se evalúa siempre en horario de Argentina
# (America/Argentina/Buenos_Aires), sin importar en qué timezone corra el
# servidor. WHATSAPP_HORA_DESDE es inclusive, WHATSAPP_HORA_HASTA es exclusivo.
WHATSAPP_HORA_DESDE=9
WHATSAPP_HORA_HASTA=18

# Días de la semana en que el negocio atiende, separados por coma, usando
# la misma numeración que Date.getDay() (0=domingo..6=sábado).
# Ejemplo: lunes a viernes = 1,2,3,4,5
WHATSAPP_DIAS=1,2,3,4,5

# Credenciales de la aplicación de MercadoLibre, usadas SOLO por los scripts
# de generación de fichas (no las usa el servidor). Se obtienen registrando
# una app gratuita en https://developers.mercadolibre.com
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Envío de correo transaccional (confirmación de órdenes al cliente, aviso de
# orden nueva a YIMA, cambios de estado). Gmail SMTP con App Password:
# la cuenta necesita verificación en 2 pasos activa, y la contraseña se genera
# en https://myaccount.google.com/apppasswords
#
# La App Password son EXACTAMENTE 16 caracteres. Google la muestra en 4 grupos
# de 4 separados por espacios: pegarla SIN los espacios y SIN comillas. Un
# valor de 15 caracteres da "535-5.7.8 Username and Password not accepted",
# un mensaje que no menciona el largo.
#
# Las tres son OBLIGATORIAS: el server no arranca sin ellas (ver lib/env.js).
SMTP_USER=yimaproductos@gmail.com
SMTP_PASSWORD=

# Destino del aviso interno de orden nueva. Separada de SMTP_USER a propósito:
# permite mandar el aviso a otra casilla sin tocar la credencial de envío.
MAIL_ADMIN_DESTINO=yimaproductos@gmail.com
