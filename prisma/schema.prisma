// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Product {
  id                Int              @id @default(autoincrement())
  nombre            String
  descripcion       String           @db.NVarChar(Max)
  precio            Decimal          @db.Decimal(10, 2)
  etiqueta          String?
  sku               String           @unique
  visibleEnCatalogo Boolean          @default(false)
  disponibilidad    String           @default("DISPONIBLE") @db.VarChar(20) // valores: DISPONIBLE | AGOTADO | A_PEDIDO
  destacado         Boolean          @default(false)
  orden             Int              @default(0) // control manual de merchandising, menor = primero
  driveFolderId     String?
  categoriaId       Int?
  categoria         Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: NoAction)
  vistas            Int              @default(0)
  compartidos       Int              @default(0)
  favoritosCount    Int              @default(0)
  caracteristicas   Caracteristica[]
  fotos             Foto[]
  video             Video?
  eventos           EventoTrafico[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([visibleEnCatalogo, orden])
  @@index([destacado])
}

model Caracteristica {
  id        Int     @id @default(autoincrement())
  texto     String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Foto {
  id                     Int     @id @default(autoincrement())
  url                    String
  driveFileId            String?
  cloudinaryPublicId     String?
  cloudinaryResourceType String?
  orden                  Int
  productId              Int
  product                Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Video {
  id                     Int     @id @default(autoincrement())
  url                    String
  driveFileId            String?
  cloudinaryPublicId     String?
  cloudinaryResourceType String?
  productId              Int     @unique
  product                Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  productos Product[]
  createdAt DateTime  @default(now())
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model EventoTrafico {
  id        Int      @id @default(autoincrement())
  tipo      String   @db.VarChar(30) // valores: VISTA_PRODUCTO | CLICK_WHATSAPP | FAVORITO_AGREGADO | AGREGADO_CARRITO | ORDEN_CREADA
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tipo, createdAt])
  @@index([productId, tipo])
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  mensaje   String   @db.NVarChar(Max)
  stack     String?  @db.NVarChar(Max)
  ruta      String?
  metodo    String?
  status    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
