// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Product {
  id                 Int              @id @default(autoincrement())
  nombre             String
  descripcion        String           @db.NVarChar(Max)
  // Entero, sin centavos: el catálogo no cotiza en fracciones de peso. La
  // escala 0 es lo que hace que `precio.toString()` salga `"45000"` y no
  // `"45000.00"`, de ahí que el JSON-LD y los mappers no necesiten formatear.
  precio             Decimal          @db.Decimal(10, 0)
  /// Costo de adquisición y multiplicador con el que se calcula el precio de
  /// venta: `precio = redondearAEntero(costo × coeficiente)`. La cuenta
  /// vive en `src/lib/precios.js`.
  ///
  /// Los dos son NULLABLE y no por prolijidad: los productos cargados antes de
  /// esta feature no tienen costo, y un `NOT NULL` sin default rompería el
  /// `prisma migrate deploy` que el Dockerfile corre en cada arranque. Un
  /// producto sin costo se comporta igual que antes — precio tipeado a mano,
  /// sin calculadora.
  ///
  /// `precio` NO se deriva de estos dos: se escribe cuando el admin aplica el
  /// cálculo desde el panel. Cambiar el costo no mueve el precio publicado.
  costo              Decimal?         @db.Decimal(10, 0)
  /// MULTIPLICADOR, no porcentaje: 2,05 significa "×2,05" (un aumento del
  /// 105 %). Es el único número con decimales del sistema, a propósito — bajo
  /// la regla de enteros que gobierna la plata no se podría representar, y
  /// forzarlo a entero perdería la mitad del rango útil.
  coeficiente        Decimal?         @db.Decimal(5, 2)
  etiquetaId         Int?
  /// `onUpdate: NoAction` va EXPLÍCITO, a diferencia de `categoriaId`, que lo
  /// deja implícito y por eso su FK quedó en `ON UPDATE CASCADE`. Acá la
  /// migración escribió `ON UPDATE NO ACTION`, y sin declararlo el schema
  /// diría otra cosa que la base: el próximo `migrate dev` propondría un ALTER
  /// fantasma. En la práctica las dos reglas se comportan igual —`Etiqueta.id`
  /// es IDENTITY y nunca se actualiza—, así que lo que se corrige es la
  /// divergencia, no el comportamiento.
  etiqueta           Etiqueta?        @relation(fields: [etiquetaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fraseComercial     String?
  porQueLoVasAQuerer String?          @db.NVarChar(Max)
  tePasaEsto         String?          @db.NVarChar(Max)
  sku                String           @unique
  visibleEnCatalogo  Boolean          @default(false)
  stock              Int              @default(0)
  destacado          Boolean          @default(false)
  driveFolderId      String?
  categoriaId        Int?
  categoria          Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: NoAction)
  vistas             Int              @default(0)
  compartidos        Int              @default(0)
  favoritosCount     Int              @default(0)
  caracteristicas    Caracteristica[]
  listas             ProductoLista[]
  especificaciones   Especificacion[]
  fotos              Foto[]
  video              Video?
  eventos            EventoTrafico[]
  itemsOrden         ItemOrden[]
  /// En qué promociones participa, con su porcentaje propio en cada una.
  itemsPromocion     PromocionItem[]
  /// En qué vitrinas de campaña aparece. NO implica descuento: un producto
  /// puede estar en la vitrina de Navidad a precio de lista.
  campanias          CampaniaProducto[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Sostiene la consulta del listado público: filtra por `visibleEnCatalogo` y
  // ordena por `createdAt` (el default `recientes`). Antes el segundo campo era
  // `orden`, el merchandising manual que se eliminó el 29/08/2026.
  @@index([visibleEnCatalogo, createdAt])
  @@index([destacado])
  @@index([categoriaId])
  @@index([etiquetaId])
}

model Caracteristica {
  id        Int     @id @default(autoincrement())
  texto     String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductoLista {
  id        Int     @id @default(autoincrement())
  tipo      String  @db.VarChar(20) // BENEFICIO | USO | IDEAL_PARA | INCLUYE
  texto     String
  orden     Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, tipo])
}

model Especificacion {
  id        Int     @id @default(autoincrement())
  nombre    String
  valor     String
  orden     Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, orden])
}

model Foto {
  id                     Int     @id @default(autoincrement())
  url                    String
  driveFileId            String?
  cloudinaryPublicId     String?
  cloudinaryResourceType String?
  orden                  Int
  productId              Int
  product                Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, orden])
}

model Video {
  id                     Int     @id @default(autoincrement())
  url                    String
  driveFileId            String?
  cloudinaryPublicId     String?
  cloudinaryResourceType String?
  productId              Int     @unique
  product                Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Categoría de producto.
///
/// Además de agrupar productos, alimenta la sección "Explorá por categoría" de
/// la home pública: qué categorías aparecen ahí y con qué foto lo decide el
/// panel (Configuración › Categorías), no un cálculo automático.
model Categoria {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  productos Product[]
  createdAt DateTime  @default(now())

  /// Foto de la categoría, sólo Cloudinary. A diferencia de `Foto`/`Video` no
  /// hay campo de Drive: esta feature nació después de la migración a
  /// Cloudinary, así que nunca puede existir una imagen de categoría legada.
  /// `url` se guarda resuelta (igual que `Foto.url`) y el `publicId` +
  /// `resourceType` existen para poder borrar el archivo remoto al
  /// reemplazarla o quitarla.
  imagenUrl                    String?
  imagenCloudinaryPublicId     String?
  imagenCloudinaryResourceType String?

  /// El nombre de un símbolo de Material Symbols (ej. "chair") para el acceso
  /// circular de la home. Sin archivo que subir y sin dependencia nueva: el
  /// proyecto ya carga esa tipografía.
  ///
  /// No se usa `imagenUrl` para el círculo: a 56 px una foto de producto es un
  /// recorte irreconocible. Sin ícono, el círculo cae a la inicial de la
  /// categoría, así que una categoría recién creada nunca rompe la fila.
  icono String? @db.VarChar(40)

  /// Selección para la home. Mismo par que `Anuncio` (`activo` + `orden`) y por
  /// el mismo motivo: `destacadaEnHome` permite sacar una categoría de la home
  /// sin perder su foto, y `ordenHome` lo reescribe entero la operación de
  /// reordenar, así que no se asume compacto ni sin repetidos más allá de lo
  /// que esa escritura deje.
  destacadaEnHome Boolean @default(false)
  ordenHome       Int     @default(0)

  @@index([destacadaEnHome, ordenHome])
}

/// Etiqueta comercial de un producto ("Nuevo", "Best Seller"), administrada
/// desde Configuración › Etiquetas.
///
/// Antes era `Product.etiqueta`, un `String?` de texto libre: nadie las
/// administraba y `Nuevo`, `nuevo` y `NUEVO ` eran tres etiquetas distintas
/// para la base. `nombre @unique` sobre una collation case-insensitive es lo
/// que hace imposible esa convivencia — es el objetivo del cambio, no un
/// efecto colateral.
///
/// `color` guarda el ID de la paleta cerrada de `src/lib/coloresEtiqueta.js`
/// (`"TERRACOTA"`, `"VERDE"`…), NUNCA un hex ni canales: la resolución a
/// valores es del backend, que los emite ya hechos en el mapper.
///
/// `color: null` significa "pintá como siempre": el chip cae al token por
/// defecto de cada superficie (`bg-tertiary` en `Badge`,
/// `bg-secondary-container` en `ProductCard`). Es lo que garantizó cero
/// regresión visual el día de la migración.
///
/// Sin `activo` ni `orden`, a diferencia de `Anuncio` y `Categoria`: no hay
/// caso de uso para desactivar una etiqueta sin borrarla, y el `<select>` del
/// formulario ordena alfabéticamente.
model Etiqueta {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique @db.NVarChar(40)
  color     String?   @db.VarChar(20)
  productos Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Mensajes de la cinta de anuncios del catálogo público (`BarraAnuncios`).
///
/// `orden` es una secuencia que define en qué sucesión desfilan; el panel la
/// reescribe entera al reordenar, así que no se asume compacta ni sin repetidos
/// más allá de lo que escriba esa operación. `activo` permite sacar un mensaje
/// de la cinta sin perder el texto, que es lo que se quiere para un anuncio
/// estacional que vuelve.
model Anuncio {
  id        Int      @id @default(autoincrement())
  texto     String   @db.NVarChar(200)
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La consulta pública es exactamente `where activo = 1 order by orden`.
  @@index([activo, orden])
}

/// Campaña comercial: define CUÁNDO está activa una experiencia comercial
/// (Doodle en el logo, modal estacional, CTA) y, más adelante, qué promociones
/// se aplican.
///
/// El estado de una campaña son DOS ejes distintos, y sólo uno se persiste:
///
///   - `estado`, el ADMINISTRATIVO, que el admin elige a mano;
///   - el TEMPORAL (PROGRAMADA/ACTIVA/FINALIZADA), que sale de las fechas y
///     NO tiene columna a propósito.
///
/// El temporal no se guarda por lo mismo que `estadoDePrecio` tampoco se
/// guarda: una columna con ese estado se desincroniza sola al pasar la
/// medianoche, sin ninguna escritura que la delate — y una campaña "ACTIVA" en
/// la base pero vencida en el calendario no falla en ningún lado, simplemente
/// le sigue mostrando el Doodle de Navidad a alguien en marzo. La única casa
/// del cálculo es `src/lib/campanias.js`.
///
/// Los valores válidos de `tipo` y `estado` viven en ese mismo módulo:
/// SQL Server vía Prisma no tiene enums, así que la columna es `VarChar` y
/// quien valida es el código (mismo criterio que `Orden.estado`).
model Campania {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.NVarChar(120)
  /// Nota interna del panel. Nunca sale al catálogo público.
  descripcion String? @db.NVarChar(1000)
  /// ESTACIONAL | EVENTO_COMERCIAL | FECHA_ESPECIAL | PROMOCIONAL | INSTITUCIONAL | OTRO
  tipo        String  @db.VarChar(20)
  /// BORRADOR | HABILITADA | DESHABILITADA — ver ESTADOS_CAMPANIA.
  estado      String  @db.VarChar(20)

  /// Los dos extremos del período, guardados como la medianoche ARGENTINA de
  /// su día (los escribe `inicioDelDiaArgentino`). El fin es INCLUSIVO: una
  /// campaña que termina el 20 vale durante todo el 20, incluidas las 21:00,
  /// que en UTC ya son el 21. Esa extensión la resuelve `estadoTemporal`, no
  /// la columna.
  desde DateTime
  hasta DateTime

  /// Desempate para los recursos visuales que sólo admiten uno a la vez (el
  /// logo es uno solo, aunque dos campañas se superpongan). Mayor gana.
  ///
  /// ⚠️ NO se usa para resolver conflictos de descuentos entre promociones:
  /// esos se deciden a mano y por producto.
  prioridad Int @default(0)

  /// Doodle: el reemplazo temporal del logo. Sólo Cloudinary, mismo trío de
  /// columnas que `Categoria.imagenUrl` y por el mismo motivo (poder borrar el
  /// archivo remoto al reemplazarlo o quitarlo).
  doodleUrl                    String?
  doodleCloudinaryPublicId     String?
  doodleCloudinaryResourceType String?
  /// Dónde se aplica el Doodle. Son dos flags y no uno porque el catálogo y el
  /// panel son públicos distintos: se puede querer la marca festiva de cara al
  /// cliente sin cambiarle el logo a quien está laburando en el admin.
  doodleEnCatalogo Boolean @default(true)
  doodleEnAdmin    Boolean @default(false)

  /// Las promociones que esta campaña aplica mientras está activa. Apagar la
  /// campaña las apaga a todas de una.
  promociones CampaniaPromocion[]

  /// La VITRINA: qué productos muestra la campaña. Es una lista explícita y
  /// SEPARADA de las promociones porque son dos preguntas distintas —"qué
  /// muestro" y "qué descuento"— y Navidad necesita la primera sin la segunda:
  /// los productos navideños se exhiben tengan o no rebaja.
  productos   CampaniaProducto[]

  /// Modal estacional del catálogo público. `modalActivo` es el interruptor:
  /// una campaña puede estar activa por su Doodle y no querer interrumpir a
  /// nadie con un cartel.
  modalActivo     Boolean @default(false)
  modalTitulo     String? @db.NVarChar(120)
  modalTexto      String? @db.NVarChar(1000)
  modalCtaTexto   String? @db.NVarChar(60)
  /// A dónde lleva el botón: la INTENCIÓN, no la ruta.
  ///
  /// CAMPANIA | CATALOGO | CATEGORIA | PRODUCTO — la lista ejecutable vive en
  /// `lib/campanias.js` (`TIPOS_DESTINO_CTA`), igual que `tipo` y `estado`.
  /// `null` significa "el modal no lleva botón".
  ///
  /// Reemplazó a `modalCtaDestino`, que guardaba una ruta escrita a mano: esa
  /// ruta no verificaba que la categoría existiera, no sobrevivía a un rename y
  /// aceptaba querystrings que ninguna pantalla lee. La ruta ahora la ARMA el
  /// backend al leer (`resolverDestinoCta`), así que siempre apunta a algo que
  /// existe hoy.
  modalCtaTipo String? @db.VarChar(20)
  /// A QUÉ categoría o producto apunta el botón, según `modalCtaTipo`. Sólo
  /// tiene sentido con CATEGORIA y PRODUCTO; con los otros tipos se fuerza a
  /// `null`.
  ///
  /// ⚠️ **SIN FK, y es deliberado.** SQL Server trata `ON DELETE SET NULL` como
  /// una acción de cascada más: una FK `Product → Campania (SET NULL)` sumada a
  /// las dos que ya existen (`Campania → CampaniaProducto` y
  /// `Product → CampaniaProducto`, las dos CASCADE) abriría dos caminos desde
  /// `Product` hasta `CampaniaProducto` y la creación fallaría con el error
  /// 1785. El razonamiento completo está anotado en
  /// `prisma/migrations/20260904000000_agregar_vitrina_campania/migration.sql`.
  ///
  /// La integridad se resuelve en las dos puntas y no con una constraint: la
  /// ESCRITURA exige que la referencia exista (`exigirReferenciaCta`) y la
  /// LECTURA degrada a `/coleccion` si quedó colgada.
  modalCtaReferenciaId Int?
  /// El día al que apunta el contador ("Faltan 18 días para la Primavera").
  /// Es SEPARADO de `hasta` a propósito: la campaña de Navidad corre del 25/11
  /// al 25/12 pero puede contar hacia el 25/12, y la de Primavera termina el 21
  /// contando hacia el 21. Que a veces coincidan no los vuelve el mismo dato.
  modalFechaObjetivo DateTime?

  /// Banner de la home: la franja que queda DESPUÉS de que el visitante cierra
  /// el cartel. Es una superficie propia y no un reflejo del modal — una
  /// campaña puede querer anunciarse sin interrumpir a nadie, o interrumpir sin
  /// dejar franja. Por eso tiene interruptor y copy propios.
  ///
  /// El DESTINO no se duplica: el banner usa `modalCtaTipo` /
  /// `modalCtaReferenciaId`, que son de la CAMPAÑA aunque el nombre diga
  /// `modal`. Una campaña tiene un solo lugar a donde mandar. Los nombres se
  /// conservan a propósito: renombrarlos es una migración de datos, rompe el
  /// contrato con el editor y ensucia los `accion` históricos de `AuditLog`.
  bannerEnHome   Boolean @default(false)
  bannerTitulo   String? @db.NVarChar(120)
  /// NVarChar(200) y no 1000 como `modalTexto`: el banner es una franja de una
  /// o dos líneas dentro del flujo de la home, no una tarjeta a pantalla
  /// completa.
  bannerTexto    String? @db.NVarChar(200)
  bannerCtaTexto String? @db.NVarChar(60)

  /// El arte apaisado del slide, SEPARADO del Doodle y con su propio trío de
  /// columnas. Son dos piezas distintas: el Doodle es cuadrado y reemplaza el
  /// logo; esto llena el slide del carrusel (2,9:1 en móvil, 3,6:1 en
  /// escritorio). Es OPCIONAL: sin arte, el slide cae al molde compuesto
  /// —doodle + copy sobre `bannerColor`—, que es el único que puede usar el
  /// slide automático de Ofertas, porque a ese no hay quién le diseñe una pieza.
  ///
  /// ⚠️ Hereda la trampa del Doodle: `duplicar` copia el `cloudinaryPublicId`
  /// por REFERENCIA, así que dos campañas pueden apuntar al mismo archivo. El
  /// borrado consulta si alguien más lo referencia antes de borrarlo.
  bannerArteUrl                    String?
  bannerArteCloudinaryPublicId     String?
  bannerArteCloudinaryResourceType String?

  /// El fondo del slide cuando no hay arte. TERRACOTA | VERDE | OCRE | TINTA |
  /// ARENA — la lista ejecutable vive en `lib/campanias.js` (`COLORES_SLIDE`),
  /// igual que `tipo` y `estado`. Es una lista CERRADA y no un color libre:
  /// cada valor mapea a un par de tokens (fondo + texto encima) que ya
  /// contrasta en los dos temas. `null` cae a `COLOR_SLIDE_POR_DEFECTO`.
  bannerColor String? @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La consulta de vigencia es exactamente `where estado = ... and desde <= hoy
  // and hasta >= hoy`.
  @@index([estado, desde, hasta])
}

/// Promoción: define QUÉ productos tienen QUÉ descuento. NO define cuándo.
///
/// La separación es el eje del módulo y no una preferencia de diseño:
///
///   PROMOCIÓN  define el descuento
///   CALENDARIO define cuándo se aplica
///
/// Por eso acá NO hay fechas. Una promoción sin programación no se aplica a
/// nadie, y la misma promoción puede programarse muchas veces sin duplicarse.
///
/// `activa` es administrativo —archivar una promo que ya no se usa sin
/// perderla— y NO tiene nada que ver con la vigencia temporal.
model Promocion {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.NVarChar(120)
  descripcion String? @db.NVarChar(1000)
  activa      Boolean @default(true)

  /// EL BANNER DE LA HOME. Espeja columna por columna al de `Campania`, con los
  /// mismos nombres y los mismos largos, para que `SlideCampania` reciba la
  /// misma forma venga de donde venga y no tenga que ramificar por origen.
  ///
  /// El interruptor es PROPIO y no un reflejo de `activa`: se puede tener la
  /// promoción descontando y el banner todavía sin publicar.
  bannerEnHome   Boolean @default(false)
  bannerTitulo   String? @db.NVarChar(120)
  /// NVarChar(200): es una franja de una o dos líneas, no una tarjeta.
  bannerTexto    String? @db.NVarChar(200)
  bannerCtaTexto String? @db.NVarChar(60)
  /// Lista cerrada de cinco valores en `lib/campanias.js`. Nullable y SIN
  /// default en la base a propósito: el default vive en un solo lado.
  bannerColor String? @db.VarChar(20)

  /// El arte apaisado del slide. Mismo trío que el Doodle y que la imagen de
  /// `Categoria`. Sin arte, el slide cae al molde compuesto sobre `bannerColor`.
  ///
  /// ⚠️ A DIFERENCIA de `Campania`, su borrado NO consulta compartidos: las
  /// promociones no tienen `duplicar`, así que dos promociones no pueden
  /// apuntar al mismo archivo. El día que exista `POST /promociones/:id/duplicar`
  /// esto deja de valer y hay que sumar la consulta, como en `limpiarArteRemoto`.
  bannerArteUrl                    String?
  bannerArteCloudinaryPublicId     String?
  bannerArteCloudinaryResourceType String?

  items          PromocionItem[]
  programaciones ProgramacionPromocion[]
  campanias      CampaniaPromocion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Un producto dentro de una promoción, con SU porcentaje.
///
/// Cada producto lleva el suyo: un descuento parejo es una comodidad del panel
/// ("aplicar el mismo a todos"), no una restricción del modelo.
///
/// `habilitado` es la granularidad del conflicto: cuando dos promociones se
/// pisan sobre un producto y el admin elige cuál gana, la perdedora queda en
/// `false` PARA ESE PRODUCTO y sigue funcionando para todos los demás. **No se
/// reactiva sola cuando termina la ganadora**: volver a `true` es una acción
/// explícita.
model PromocionItem {
  id          Int       @id @default(autoincrement())
  promocionId Int
  promocion   Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Entero entre 5 y 50. Los límites viven en `lib/precioEfectivo.js`.
  porcentaje  Int
  habilitado  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un producto no puede estar dos veces en la misma promoción: cuál de los dos
  // porcentajes gana no tendría respuesta.
  @@unique([promocionId, productId])
  // La resolución del precio entra por productId, no por promoción.
  @@index([productId])
}

/// Programación INDIVIDUAL: una promoción en el calendario, sin campaña.
///
/// `desde`/`hasta` guardan la medianoche ARGENTINA de su día y el fin es
/// inclusivo, igual que en `Campania`.
///
/// Es una tabla SEPARADA de `CampaniaPromocion` y no un `campaniaId` nullable
/// acá: una promoción dentro de una campaña hereda las fechas de la campaña y no
/// puede tener las propias. Con un solo modelo, `desde`/`hasta` serían nullable
/// y la consulta de vigencia necesitaría un COALESCE sobre un join — el índice
/// dejaría de servir justo en la consulta que corre en cada listado.
model ProgramacionPromocion {
  id          Int       @id @default(autoincrement())
  promocionId Int
  promocion   Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  desde       DateTime
  hasta       DateTime
  /// El OFF manual de esta programación, sin tocar la promoción ni sus fechas.
  habilitada  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([habilitada, desde, hasta])
}

/// Promoción DENTRO de una campaña: la vigencia la hereda de la campaña.
///
/// De acá sale la regla de que apagar una campaña apaga TODAS sus promociones
/// de una, sin desactivar nada una por una.
model CampaniaPromocion {
  campaniaId  Int
  campania    Campania  @relation(fields: [campaniaId], references: [id], onDelete: Cascade)
  promocionId Int
  promocion   Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([campaniaId, promocionId])
  @@index([promocionId])
}

/// Producto DENTRO de la vitrina de una campaña: qué productos muestra.
///
/// Resuelve una pregunta que las promociones NO contestan. Una promoción define
/// un descuento; la vitrina define una selección. "Navidad" quiere exhibir todos
/// los productos navideños tengan o no rebaja, y con solo `CampaniaPromocion` la
/// única forma de listarlos sería inventarles un descuento del 5 %.
///
/// Es una asociación PURA: no lleva porcentaje, ni orden, ni flag propio. Todo
/// lo que se sepa del producto se lee del producto, y todo lo que se sepa de la
/// vigencia se lee de la campaña. Una columna acá sería un tercer lugar donde
/// guardar algo que ya tiene dueño.
model CampaniaProducto {
  campaniaId Int
  campania   Campania @relation(fields: [campaniaId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([campaniaId, productId])
  @@index([productId])
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  /// Versión de sesión del usuario. Se incrementa al cambiar la contraseña
  /// para invalidar TODOS los JWT emitidos antes del cambio: el login copia
  /// este número como claim `tokenVersion` en el token, y `requireAuth`
  /// (src/middlewares/auth.middleware.js) lo compara contra esta columna en
  /// cada request. Si difieren, la sesión está revocada.
  ///
  /// `@default(0)` hace que el ADD COLUMN sea seguro para las filas existentes
  /// (backfill implícito a 0) y evita romper el `prisma migrate deploy` que el
  /// Dockerfile corre al arrancar. Un token viejo emitido antes de esta feature
  /// no trae el claim y por eso NO coincide con este 0 — queda revocado, que es
  /// el comportamiento fail-closed buscado.
  tokenVersion Int      @default(0)
  /// ¿Este admin puede ejecutar acciones destructivas (borrar productos,
  /// categorías, anuncios y otros usuarios)?
  ///
  /// El sistema NO tiene roles, y sigue sin tenerlos: esto es un único flag
  /// sobre la clase de acción que no tiene vuelta atrás, no el primer paso de
  /// un RBAC. Lo verifica `middlewares/permisoBorrado.middleware.js`, después
  /// de `requireAuth`.
  ///
  /// `@default(true)` NO es descuido, es lo único correcto: con `false` el
  /// primer deploy dejaría a TODOS los admin sin poder borrar nada, y la
  /// operación se frenaría hasta que alguien editara la base a mano. Los
  /// usuarios existentes conservan lo que ya podían hacer; restringir es una
  /// decisión explícita que se toma después, usuario por usuario, desde
  /// /catalogo/admin/usuarios.
  ///
  /// Se lee de la BASE en cada request (misma consulta que ya verifica
  /// `tokenVersion`), nunca del JWT: quitarle el permiso a alguien surte efecto
  /// en la request siguiente, no cuando expire su token 24 horas después.
  puedeEliminar Boolean @default(true)
  createdAt    DateTime @default(now())
}

model EventoTrafico {
  id        Int      @id @default(autoincrement())
  tipo      String   @db.VarChar(30) // valores: VISTA_PRODUCTO | CLICK_WHATSAPP | FAVORITO_AGREGADO | AGREGADO_CARRITO | ORDEN_CREADA | COMPARTIDO
  // Es VarChar y no un enum de Prisma a propósito: agregar un tipo nuevo es una
  // línea en `TIPOS_VALIDOS` (eventos.controller.js), sin migración de base.
  // La fuente de verdad es esa constante — este comentario debe seguirla.
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tipo, createdAt])
  @@index([productId, tipo])
  @@index([createdAt])
}

model Cliente {
  id        Int      @id @default(autoincrement())
  dni       String   @unique
  nombre    String
  telefono  String
  email     String?
  ordenes   Orden[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Orden {
  id        Int         @id @default(autoincrement())
  clienteId Int
  cliente   Cliente     @relation(fields: [clienteId], references: [id], onDelete: NoAction)
  // valores: PENDIENTE | EN_PREPARACION | ENTREGADA | CANCELADA
  // No es un enum porque SQL Server vía Prisma no los soporta: quien valida
  // de verdad es src/lib/estadosOrden.js, que es la única copia ejecutable.
  estado    String      @default("PENDIENTE") @db.VarChar(20)
  // ¿Esta orden tiene stock TOMADO ahora mismo?
  //
  // No se deduce del estado a propósito: la re-confirmación está fuera de
  // alcance (EN_PREPARACION -> ENTREGADA -> EN_PREPARACION no vuelve a
  // descontar), así que "está en un estado que toma stock" no implica por sí
  // solo "hay que descontar ahora". Sin esta columna, cancelar devolvería
  // unidades que nunca se sacaron.
  //
  // Lo enciende la escritura guardada que descuenta al confirmar y lo apaga la
  // que libera al cancelar; ese par de escrituras es lo que hace que el
  // descuento y la devolución ocurran exactamente una vez cada uno.
  stockDescontado Boolean @default(false)
  notas     String?     @db.NVarChar(Max)
  items     ItemOrden[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([clienteId])
  @@index([estado, createdAt])
  @@index([createdAt])
}

model ItemOrden {
  id             Int     @id @default(autoincrement())
  ordenId        Int
  orden          Orden   @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  // Nullable con SetNull: borrar un producto DESLIGA sus líneas históricas en
  // vez de quedar bloqueado por ellas. Era `NoAction`, y eso hacía imborrable
  // a cualquier producto que apareciera en una orden — incluidas las
  // CANCELADAS, que el propio proyecto no cuenta como ventas.
  //
  // La orden no pierde nada legible: `nombreProducto` y `precioUnitario` son
  // snapshots y existen exactamente para que la línea sobreviva sin el
  // producto. Lo que SÍ se pierde para siempre es el vínculo con el producto,
  // así que el ranking de `admin.controller.js` no puede agrupar por
  // `productId` a secas — con varios borrados, todos caerían en la clave null
  // y sumarían su facturación en una sola fila.
  productId      Int?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  nombreProducto String // snapshot, no se recalcula
  precioUnitario Decimal @db.Decimal(10, 0) // snapshot entero, no se recalcula
  /// Lo que el producto valía SIN promoción, y el porcentaje que se aplicó.
  ///
  /// `precioUnitario` guarda lo que el cliente PAGÓ —el promocional, si había
  /// promo— porque es lo que se facturó y lo que suman las métricas. Estas dos
  /// columnas existen para poder contestar después "¿cuánta plata regalé en la
  /// campaña de Primavera?": sin ellas ese dato no queda registrado en ningún
  /// lado, porque el precio de lista puede cambiar en cualquier momento.
  ///
  /// Nullable, y el `null` significa **"esta línea no tuvo descuento"** — que es
  /// la verdad para todo el histórico anterior a esta migración. NO significa
  /// "descuento cero", que es un dato distinto y que no puede existir: el
  /// mínimo es 5 %.
  precioListaUnitario Decimal? @db.Decimal(10, 0)
  descuentoPorcentaje Int?
  // Snapshot del COSTO al momento de la compra, por el mismo motivo que
  // `precioUnitario`: sin él, el margen de una venta pasada se calcularía
  // contra el `Product.costo` de HOY, así que cada aumento de un proveedor
  // reescribiría las ganancias de todos los meses anteriores. Sin error y sin
  // aviso.
  //
  // Nullable porque las órdenes anteriores a esta columna no lo tienen, y
  // porque un producto sin costo cargado tampoco puede aportarlo. Un `null`
  // significa "no se puede calcular el margen de esta línea", nunca "margen 0".
  //
  // No se puede rellenar hacia atrás: el costo vigente en el momento de una
  // venta vieja no quedó registrado en ninguna parte.
  costoUnitario  Decimal? @db.Decimal(10, 0)
  cantidad       Int

  @@index([ordenId])
  @@index([productId])
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  mensaje   String   @db.NVarChar(Max)
  stack     String?  @db.NVarChar(Max)
  ruta      String?
  metodo    String?
  status    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Traza de auditoría de las mutaciones del panel admin (quién hizo qué y
// cuándo). Solo escrituras — las lecturas no se auditan.
//
// `usuarioEmail` es un SNAPSHOT copiado al momento de escribir, NO una
// relación a `Usuario`: mismo criterio que `ItemOrden.nombreProducto`/
// `precioUnitario`. Es deliberado — si después se borra el usuario admin, la
// traza tiene que seguir diciendo quién hizo cada cosa. Una FK con onDelete
// haría exactamente lo contrario (borraría o anularía la evidencia).
// `usuarioId` se guarda igual, pero solo como referencia informativa.
model AuditLog {
  id           Int      @id @default(autoincrement())
  usuarioId    Int?
  usuarioEmail String
  accion       String   @db.VarChar(50) // valores: CREAR | ACTUALIZAR | ELIMINAR (+ variantes por recurso)
  entidad      String   @db.VarChar(50) // valores: Producto | Orden | Usuario | Categoria
  entidadId    Int?
  detalle      String?  @db.NVarChar(Max) // resumen JSON de lo que cambió
  ruta         String
  metodo       String   @db.VarChar(10)
  ip           String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([entidad, createdAt])
}
